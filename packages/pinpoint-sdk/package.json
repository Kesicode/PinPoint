{
  "name": "pinpoint-sdk",
  "version": "0.1.0",
  "description": "PinPoint SDK — on-device GNSS integrity monitoring for Expo: raw C/N0 measurements, sensor fusion, seven physics consistency checks, deterministic RAIM/FDE state machine, and on-device AI explanation.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "keywords": [
    "react-native",
    "expo",
    "gnss",
    "gps-integrity",
    "anti-spoofing",
    "pinpoint-sdk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Kesicode/PinPoint.git",
    "directory": "packages/pinpoint-sdk"
  },
  "bugs": {
    "url": "https://github.com/Kesicode/PinPoint/issues"
  },
  "author": "kesicode <kesicode@users.noreply.github.com> (https://github.com/kesicode)",
  "license": "MIT",
  "homepage": "https://github.com/Kesicode/PinPoint#readme",
  "dependencies": {
    "expo-asset": "^57.0.15",
    "expo-file-system": "^57.0.6",
    "expo-location": "^57.0.14",
    "expo-sensors": "^57.0.2",
    "react-native-executorch": "^0.9.3",
    "react-native-executorch-expo-resource-fetcher": "^0.9.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "json",
      "js"
    ]
  }
}
